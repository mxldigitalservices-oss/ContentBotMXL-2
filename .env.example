# --- Integracion con n8n (Servidor 1, externo) ---
# Secreto compartido: n8n debe enviarlo en el header X-Webhook-Secret
N8N_WEBHOOK_SECRET=

# --- Motor de IA (Servidor 2 - Railway) ---
GEMINI_API_KEY=

# --- Voz (edge-tts, gratuito, no requiere API key) ---
# Opcional: cambia la voz neuronal usada para narrar. Por defecto es-MX-DaliaNeural.
TTS_VOZ=es-MX-DaliaNeural

# --- Publicacion en YouTube (opcional) ---
# Se consiguen UNA sola vez corriendo scripts/obtener_refresh_token_youtube.py
# en tu maquina local (ver ese script y README.md para el paso a paso).
YOUTUBE_CLIENT_ID=
YOUTUBE_CLIENT_SECRET=
YOUTUBE_REFRESH_TOKEN=
# private | unlisted | public
YOUTUBE_PRIVACY_STATUS=private
# true/false - contenido infantil declarado "made for kids" (requisito COPPA)
YOUTUBE_MADE_FOR_KIDS=true

# --- App ---
LOG_LEVEL=INFO
